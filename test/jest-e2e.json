{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "moduleDirectories": ["node_modules", "<rootDir>"],
  "testEnvironment": "node",
  "testTimeout": 30000,
  "setupFiles": ["<rootDir>/test/jest-e2e-setup.ts"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
