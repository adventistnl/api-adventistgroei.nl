<html>
  <body style="font-family: Arial, sans-serif; line-height: 1.6; color: #2a2a2a; background-color: #fafafa; margin: 0; padding: 0;">
    <div style="max-width: 600px; margin: 40px auto; background-color: #ffffff; border-radius: 10px; overflow: hidden; border: 1px solid #e5e7eb;">

      <!-- Header -->
      <div style="background-color: #2a2a2a; padding: 32px 40px; text-align: center;">
        <h1 style="color: #fafafa; margin: 0; font-size: 18px; font-weight: 600; letter-spacing: 0.5px;">Adventist Groei</h1>
        <p style="color: #9ca3af; margin: 6px 0 0; font-size: 13px;">{{subject}}</p>
      </div>

      <!-- Body -->
      <div style="padding: 40px;">
        <p style="font-size: 15px; margin: 0 0 12px; color: #2a2a2a;">{{greeting}}</p>
        <p style="font-size: 14px; color: #6b7280; margin: 0 0 28px;">{{body}}</p>

        <!-- OTP Code Box -->
        <div style="background-color: #f5f5f5; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px; text-align: center; margin: 0 0 24px;">
          <p style="margin: 0 0 6px; font-size: 11px; color: #9ca3af; text-transform: uppercase; letter-spacing: 1.5px;">Verification Code</p>
          <p style="margin: 0; font-size: 36px; font-weight: 700; letter-spacing: 10px; color: #2a2a2a; font-family: 'Courier New', monospace;">{{code}}</p>
        </div>

        <p style="color: #6b7280; font-size: 13px; margin: 0 0 8px;">⏱ {{expiry}}</p>
        <p style="color: #9ca3af; font-size: 12px; margin: 0;">{{ignore}}</p>
      </div>

      <!-- Footer -->
      <div style="border-top: 1px solid #e5e7eb; padding: 20px 40px; text-align: center; background-color: #fafafa;">
        <p style="margin: 0; font-size: 12px; color: #9ca3af;">{{footer}}</p>
      </div>
    </div>
  </body>
</html>
