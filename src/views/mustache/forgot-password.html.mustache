<html>
  <body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
    <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
      <h2 style="color: #2c3e50;">{{subject}}</h2>
      
      <p>{{greeting}}</p>
      
      <p style="margin-bottom: 20px;">{{body}}</p>
      
      <div style="background-color: #f0f0f0; padding: 15px; border-radius: 5px; text-align: center; margin: 20px 0;">
        <p style="margin: 0; font-size: 12px; color: #777;">Your verification code is:</p>
        <p style="margin: 10px 0; font-size: 32px; font-weight: bold; letter-spacing: 5px; color: #2c3e50;">{{code}}</p>
      </div>
      
      <p style="color: #e74c3c; font-weight: bold;">{{expiry}}</p>
      
      <p style="color: #7f8c8d; font-size: 12px;">{{ignore}}</p>
      
      <hr style="border: none; border-top: 1px solid #ddd; margin: 20px 0;" />
      
      <footer style="text-align: center; font-size: 12px; color: #7f8c8d;">
        {{footer}}
      </footer>
    </div>
  </body>
</html>
