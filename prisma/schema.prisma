// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator nestgraphql {
  provider = "prisma-nestjs-graphql"
  output   = "../src/@generated" // Diretório onde os tipos serão gerados
}

// Enums
enum LanguagePreference {
  en
  nl
}

enum EventTargetType {
  institution
  region
  department
  church
  user
}

enum EventType {
  show
  evangelism
}

enum EventRegistrationStatus {
  paid
  pendent
  reserved
  approved
  canceled
}

enum PermissionResolverName {
  users
  user
  createUser
  updateUser
  deleteUser
  addRoleToUser
  removeRoleFromUser
  createInstitution
  institutions
  institution
  updateInstitution
  deleteInstitution
  regions
  region
  createRegion
  updateRegion
  deleteRegion
  churches
  church
  createChurch
  updateChurch
  deleteChurch
  churchActivityTimeline
  permissions
  createRole
  updateRole
  deleteRole
  roles
  role
  auth
  departments
  department
  createDepartment
  updateDepartment
  deleteDepartment
  communications
  communication
  createCommunication
  updateCommunication
  deleteCommunication
  directMessages
  directMessage
  createDirectMessage
  updateDirectMessage
  deleteDirectMessage
  projects
  project
  createProject
  updateProject
  deleteProject
  notifications
  notification
  createNotification
  updateNotification
  deleteNotification
  settings
  setting
  createSetting
  updateSetting
  deleteSetting
  subsidyRequests
  subsidyRequest
  createSubsidyRequest
  updateSubsidyRequest
  deleteSubsidyRequest
  approveSubsidyRequest
  rejectSubsidyRequest
  subsidyStatuses
  subsidyStatus
  createSubsidyStatus
  updateSubsidyStatus
  deleteSubsidyStatus
  addProjectVoluntary
  removeProjectVoluntary
  projectActivities
  projectActivity
  createProjectActivity
  updateProjectActivity
  deleteProjectActivity
  batchUpdateProjectActivities
  projectActivityLogs
  sendInviteEmail
  inviteUser
  validateInviteToken
  annualBudgets
  annualBudget
  deleteAnnualBudget
  approveAnnualBudget
  rejectAnnualBudget
  requestRevisionAnnualBudget
  toggleBudgetLock
  budgetKPIs
  departmentSpending
  spendingOverTime
  entityDistribution
  budgetDistribution
  institutionalDepartmentsKPIs
  recalculateInstitutionAllocatedAmounts
  createInstitutionBudget
  updateInstitutionBudget
  createDepartmentBudget
  updateDepartmentBudget
  churchesActivityData
  projectKPIs
  projectsByDepartment
  subsidyStatusDistribution
  projectsTimeline
  departmentKPIs
  departmentActivityData
  departmentBudgetTimeline
  uploadActivityDocument
  downloadActivityDocument
  deleteActivityDocument
  validateActivityDocument
  getActivityDocuments
}

enum PermissionGroup {
  USER
  INSTITUTION
  CHURCH
  REGION
  CONTACT
  ROLE
  PERMISSION
  DEPARTMENT
  COMMUNICATION
  DIRECT_MESSAGE
  PROJECT
  ACTIVITY
  ACTIVITY_DOCUMENT
  NOTIFICATION
  SETTING
  SUBSIDY_REQUEST
  SUBSIDY_STATUS
  EMAIL_SEND
  INVITE
  ANNUAL_BUDGET
}

enum CommunicationType {
  EMAIL
  SMS
  PUSH_NOTIFICATION
  IN_APP_MESSAGE
}

enum CommunicationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CommunicationStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
}

enum ProjectType {
  Local
  Global
}

enum AnnualBudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUESTED
  IN_PROGRESS
  CLOSED
}

enum AnnualBudgetPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AnnualBudgetCategory {
  OPERATIONAL
  PROJECT
  MAINTENANCE
  EMERGENCY
  EXPANSION
}

enum AnnualBudgetEntityType {
  INSTITUTION
  CHURCH
  INSTITUTION_DEPARTMENT
  CHURCH_DEPARTMENT
}

enum ActivityTags {
  EQUIPMENT
  MATERIALS
  SERVICES
  TRAVEL
  EVENT
  TRANSPORT
  MARKETING
  REFORM
  TRAINING
  FEEDING
  ACCOMMODATION
}

enum ActivityStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum ActivityPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum EntityType {
  INSTITUTION
  REGION
  CHURCH
  INSTITUTION_DEPARTMENT
  CHURCH_DEPARTMENT
  USER
}

enum ChurchType  {
  PLANT
  COMPANY
  STANDARD
}

enum GenderType {
  MALE
  FEMALE
}

// Models
model Institution {
  id                  String             @id @default(uuid())
  name                String
  denomination        String
  description         String?
  language_preference LanguagePreference
  contact_id          String?            @unique
  contact             Contact?           @relation(fields: [contact_id], references: [id])
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  created_by          String
  updated_by          String
  is_deleted          Boolean            @default(false)
  deleted_at          DateTime?
  deleted_by          String?
  churches            Church[]
  departments         Department[]
  users               User[]
  communications      Communication[]
  notifications       Notification[]
  settings            Setting[]
  projects            Project[]
  direct_messages     DirectMessage[]
  subsidy_requests    SubsidyRequest[]
  annual_budgets      AnnualBudget[]    
}

model Region {
  id               String        @id @default(uuid())
  description      String?
  name             String
  territory        Json?
  color            String?       @default("#9810fa")
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  created_by       String
  updated_by       String
  is_deleted       Boolean       @default(false)
  deleted_at       DateTime?
  deleted_by       String?
  churches         Church[]
}

model Church {
  id               String                 @id @default(uuid())
  type             ChurchType             @default(STANDARD)
  institution_id   String
  institution      Institution            @relation(fields: [institution_id], references: [id])
  name             String
  region_id        String?
  region           Region?                @relation(fields: [region_id], references: [id])
  contact_id       String?
  contact          Contact?               @relation(fields: [contact_id], references: [id])
  created_at       DateTime               @default(now())
  updated_at       DateTime               @updatedAt
  created_by       String
  updated_by       String
  is_deleted       Boolean                @default(false)
  deleted_at       DateTime?
  deleted_by       String?
  departments      Department[]
  users            User[]
  subsidy_requests SubsidyRequest[]
  annual_budgets   AnnualBudget[]
}

model Department {
  id               String           @id @default(uuid())
  institution_id   String
  institution      Institution      @relation(fields: [institution_id], references: [id])
  church_id        String?
  church           Church?           @relation(fields: [church_id], references: [id])
  name             String
  description      String
  contact_id       String?
  contact          Contact?         @relation(fields: [contact_id], references: [id])
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  created_by       String
  updated_by       String
  is_deleted       Boolean          @default(false)
  deleted_at       DateTime?
  deleted_by       String?
  subsidy_statuses SubsidyStatus[]
  projects         Project[]
  annual_reports   AnnualReport[]
  subsidy_requests SubsidyRequest[]
  users            User[]
  annual_budgets   AnnualBudget[]  
}

// Modelo AnnualBudget
model AnnualBudget {
  id                    String             @id @default(uuid())
  year                  Int
  planned_budget        Decimal
  total_expenses        Decimal
  balance               Decimal
  notes                 String?
  description           String?
  justification         String?
  approved_by           String?
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt
  created_by            String
  updated_by            String
  is_deleted            Boolean            @default(false)
  deleted_at            DateTime?
  deleted_by            String?
  approved_user         User?              @relation("ApprovedAnnualBudgets", fields: [approved_by], references: [id])
  status                AnnualBudgetStatus @default(DRAFT)
  institution_id        String?
  institution           Institution?       @relation(fields: [institution_id], references: [id])
  church_id             String?
  church                Church?            @relation(fields: [church_id], references: [id])
  department_id         String?
  department            Department?        @relation(fields: [department_id], references: [id])
  allocated_amount      Decimal
  approved_amount       Decimal?
  requested_by          String
  reviewed_by           String?
  submitted_date        DateTime  @default(now())
  review_date           DateTime?
  approval_date         DateTime?
  priority              AnnualBudgetPriority @default(MEDIUM)
  category              AnnualBudgetCategory @default(OPERATIONAL)
  documents             Json?
  is_locked             Boolean   @default(false)
  has_budget_record     Boolean   @default(true)
  entity_type           AnnualBudgetEntityType
}

model Contact {
  id           String       @id @default(uuid())
  name         String?
  phone        String?
  mobile       String?
  email        String?
  country      String?
  city         String?
  state        String? 
  address      String?
  full_address String?
  postal_code  String?
  website      String?
  notes        String?
  is_primary   Boolean
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  created_by   String
  updated_by   String
  is_deleted   Boolean      @default(false)
  deleted_at   DateTime?
  deleted_by   String?
  Institution  Institution?
  Church       Church[]
  Department   Department[]
  User         User[]
  Event        Event[]
}

model User {
  id                        String                   @id @default(uuid())
  name                      String
  email                     String                   @unique
  password                  String
  gender                    GenderType?              @default(MALE)
  language_preference       LanguagePreference
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt
  created_by                String
  updated_by                String
  is_deleted                Boolean                  @default(false)
  deleted_at                DateTime?
  deleted_by                String?
  contact_id                String?
  contact                   Contact?                 @relation(fields: [contact_id], references: [id])
  institution_id            String
  institution               Institution              @relation(fields: [institution_id], references: [id])
  church_id                 String?
  church                    Church?                  @relation(fields: [church_id], references: [id])
  department_id             String?
  department                Department?               @relation(fields: [department_id], references: [id])
  user_roles                UserRole[]
  direct_messages           DirectMessage[]          @relation("SenderMessages")
  direct_message_recipients DirectMessageRecipient[] @relation("RecipientMessages")
  notifications             Notification[]
  event_registrations       EventRegistration[]
  event_recipients          EventRecipient[]
  communications            Communication[]          @relation("AuthorCommunications")
  SubsidyRequest            SubsidyRequest[]
  SubsidyStatus             SubsidyStatus[]
  voluntary_projects        VoluntariesOnProjects[]
  Project                   Project[]
  approved_annual_budgets   AnnualBudget[]           @relation("ApprovedAnnualBudgets")
  project_activity_logs     ProjectActivityLog[]
  activity_assignments      ProjectActivityAssignee[] @relation("ActivityAssignees")
}

model Project {
  id                  String                  @id @default(uuid())
  department_id       String
  department          Department              @relation(fields: [department_id], references: [id])
  title               String
  description         String
  budget              Decimal
  owner_id            String
  owner               User                    @relation(fields: [owner_id], references: [id])
  language_preference LanguagePreference
  type                ProjectType
  is_private          Boolean                 @default(false)
  required_volunteers Boolean                 @default(false)
  start_at            DateTime
  end_at              DateTime
  created_at          DateTime                @default(now())
  updated_at          DateTime                @updatedAt
  deadline            DateTime?
  created_by          String
  updated_by          String
  is_deleted          Boolean                 @default(false)
  deleted_at          DateTime?
  deleted_by          String?
  event_id            String?
  event               Event?                  @relation(fields: [event_id], references: [id])
  Institution         Institution?            @relation(fields: [institution_id], references: [id])
  institution_id      String?
  voluntary_users     VoluntariesOnProjects[]
  activities          ProjectActivity[]
  subsidies           SubsidyRequest[]
  special_projects    SpecialProjects[]
}

model VoluntariesOnProjects {
  user       User    @relation(fields: [user_id], references: [id])
  user_id    String
  project    Project @relation(fields: [project_id], references: [id])
  project_id String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String
  updated_by String
  is_deleted Boolean @default(false)
  deleted_at DateTime?
  deleted_by String?

  @@id([user_id, project_id])
}

model Role {
  id                        String                   @id @default(uuid())
  name                      String
  description               String
  color                     String?                  @default("#3b82f6")
  key_code                  String                   @unique
  is_fixed                  Boolean                  @default(false)
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt
  created_by                String
  updated_by                String
  is_deleted                Boolean                  @default(false)
  deleted_at                DateTime?
  deleted_by                String?
  user_roles                UserRole[]
  role_permissions          RolePermission[]
  direct_message_recipients DirectMessageRecipient[]
}

model Permission {
  id                 String                 @id @default(uuid())
  name               String
  description        String
  key_code           String                 @unique
  resolver_name      PermissionResolverName @unique
  group              PermissionGroup?
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt
  created_by         String
  updated_by         String
  is_deleted         Boolean                @default(false)
  deleted_at         DateTime?
  deleted_by         String?
  role_permissions   RolePermission[]
  disabled_to_client Boolean                @default(false)
}

model RolePermission {
  id            String     @id @default(uuid())
  role_id       String
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [id])
  is_essential  Boolean    @default(false)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  created_by    String
  updated_by    String
  is_deleted    Boolean    @default(false)
  deleted_at    DateTime?
  deleted_by    String?
}

model UserRole {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id])
  role_id    String
  role       Role      @relation(fields: [role_id], references: [id])
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  created_by String
  updated_by String
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?
}

model SubsidyRequest {
  id                  String                  @id @default(uuid())
  description         String
  total_budget        Decimal
  approved_amount     Decimal                 @default(0)
  rejection_reason    String?
  created_at          DateTime                @default(now())
  updated_at          DateTime                @updatedAt
  approved_at         DateTime?
  created_by          String
  updated_by          String
  approved_by         String?
  is_deleted          Boolean                 @default(false)
  deleted_at          DateTime?
  deleted_by          String?
  institution_id      String
  institution         Institution             @relation(fields: [institution_id], references: [id])
  requester_id        String
  requester           User                    @relation(fields: [requester_id], references: [id])
  department_id       String
  department          Department              @relation(fields: [department_id], references: [id])
  church_id           String?
  church              Church?                 @relation(fields: [church_id], references: [id])
  subsidy_statuses_id String
  subsidy_status      SubsidyStatus           @relation(fields: [subsidy_statuses_id], references: [id])
  items               SubsidyRequestItem[]
  project_id          String
  project             Project                 @relation(fields: [project_id], references: [id])
  subsidy_receipts    SubsidyReceipt[]
}

model SubsidyRequestItem {
  id                   String          @id @default(uuid())
  subsidy_request_id   String
  subsidy_request      SubsidyRequest  @relation(fields: [subsidy_request_id], references: [id], onDelete: Cascade)
  project_activity_id  String
  project_activity     ProjectActivity @relation(fields: [project_activity_id], references: [id])
  requested_amount     Decimal
  approved_amount      Decimal         @default(0)
  notes                String?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt
  is_deleted           Boolean         @default(false)
  deleted_at           DateTime?
  deleted_by           String?

  @@index([subsidy_request_id])
  @@index([project_activity_id])
}

model ProjectActivity {
  id                    String                   @id @default(uuid())
  subsidy_request_items SubsidyRequestItem[]
  project_id          String
  project             Project                  @relation(fields: [project_id], references: [id])
  name                String
  description         String
  budget_amount       Decimal
  created_at          DateTime                 @default(now())
  updated_at          DateTime                 @updatedAt
  created_by          String
  updated_by          String
  is_deleted          Boolean                  @default(false)
  deleted_at          DateTime?
  deleted_by          String?
  subsidy_receipts    SubsidyReceipt[]
  activity_documents  ActivityDocuments[]
  deadline            DateTime
  tags                ActivityTags[]
  custom_tags         String[]                 @default([])
  activity_funding    ActivityFunding?
  status              ActivityStatus           @default(TODO)
  priority            ActivityPriority         @default(MEDIUM)
  is_subsidized       Boolean                  @default(false)
  logs                ProjectActivityLog[]
  assignees           ProjectActivityAssignee[]
}

// Tabela de relação muitos-para-muitos entre ProjectActivity e User (responsáveis)
model ProjectActivityAssignee {
  id                  String          @id @default(uuid())
  activity_id         String
  activity            ProjectActivity @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  user_id             String
  user                User            @relation("ActivityAssignees", fields: [user_id], references: [id])
  created_at          DateTime        @default(now())
  created_by          String

  @@unique([activity_id, user_id])
  @@index([activity_id])
  @@index([user_id])
}

enum ProjectActivityLogAction {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
  BUDGET_UPDATED
  DEADLINE_UPDATED
  TAG_ADDED
  TAG_REMOVED
  SUBSIDIZED_CHANGED
}

model ProjectActivityLog {
  id                String                     @id @default(uuid())
  activity_id       String
  activity          ProjectActivity            @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  user_id           String
  user              User                       @relation(fields: [user_id], references: [id])
  action            ProjectActivityLogAction
  field_name        String?                    // Nome do campo alterado (ex: "status", "priority")
  old_value         String?                    // Valor antigo em formato JSON ou string
  new_value         String?                    // Valor novo em formato JSON ou string
  metadata          Json?                      // Metadados adicionais em JSON
  created_at        DateTime                   @default(now())

  @@index([activity_id])
  @@index([user_id])
  @@index([created_at])
}

model SubsidyReceipt {
  id                    String          @id @default(uuid())
  project_activities_id String
  project_activity      ProjectActivity @relation(fields: [project_activities_id], references: [id])
  file_path             String
  amount                Decimal
  approved              Boolean
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt
  created_by            String
  updated_by            String
  is_deleted            Boolean         @default(false)
  deleted_at            DateTime?
  deleted_by            String?
  subsidy_request_id    String?
  subsidy_request       SubsidyRequest? @relation(fields: [subsidy_request_id], references: [id])
}

model SubsidyStatus {
  id               String            @id @default(uuid())
  department_id    String
  department       Department        @relation(fields: [department_id], references: [id])
  assigned_to      String
  assigned_user    User              @relation(fields: [assigned_to], references: [id])
  name             String
  description      String
  order            Int
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  created_by       String
  updated_by       String
  is_deleted       Boolean           @default(false)
  deleted_at       DateTime?
  deleted_by       String?
  subsidy_requests SubsidyRequest[]
  special_projects SpecialProjects[]
}

model AnnualReport {
  id              String     @id @default(uuid())
  department_id   String
  department      Department @relation(fields: [department_id], references: [id])
  text            String
  file_path       String
  submission_date DateTime
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  created_by      String
  updated_by      String
  is_deleted      Boolean    @default(false)
  deleted_at      DateTime?
  deleted_by      String?
}

model Event {
  id                      String              @id @default(uuid())
  target_type             EventTargetType
  target_id               String?
  title                   String
  description             String
  contact_id              String
  contact                 Contact             @relation(fields: [contact_id], references: [id])
  type                    EventType
  language_preference     LanguagePreference
  max_participants        Int
  ticket_amount           Decimal
  location                String?
  is_private              Boolean             @default(false)
  required_volunteers     Boolean             @default(false)
  start_at                DateTime?
  end_at                  DateTime?
  subscription_expires_at DateTime
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt
  created_by              String
  updated_by              String
  is_deleted              Boolean             @default(false)
  deleted_at              DateTime?
  deleted_by              String?
  event_recipients        EventRecipient[]
  event_registrations     EventRegistration[]
  projects                Project[]
}

model EventRecipient {
  id          String          @id @default(uuid())
  event_id    String
  event       Event           @relation(fields: [event_id], references: [id], onDelete: Cascade)
  target_type EventTargetType
  target_id   String
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  created_by  String
  updated_by  String
  is_deleted  Boolean         @default(false)
  deleted_at  DateTime?
  deleted_by  String?
  User        User?           @relation(fields: [userId], references: [id])
  userId      String?
}

model EventRegistration {
  id         String                  @id @default(uuid())
  user_id    String
  user       User                    @relation(fields: [user_id], references: [id])
  event_id   String
  event      Event                   @relation(fields: [event_id], references: [id])
  status     EventRegistrationStatus
  created_at DateTime                @default(now())
  updated_at DateTime                @updatedAt
  created_by String
  updated_by String
  is_deleted Boolean                 @default(false)
  deleted_at DateTime?
  deleted_by String?
}

model Communication {
  id                       String                   @id @default(uuid())
  institution_id           String
  institution              Institution              @relation(fields: [institution_id], references: [id])
  title                    String
  content                  String
  type                     String
  priority                 String
  status                   String
  language_preference      LanguagePreference
  schedule_at              DateTime
  published_at             DateTime
  author_id                String
  author                   User                     @relation("AuthorCommunications", fields: [author_id], references: [id])
  created_at               DateTime                 @default(now())
  updated_at               DateTime                 @updatedAt
  created_by               String
  updated_by               String
  is_deleted               Boolean                  @default(false)
  deleted_at               DateTime?
  deleted_by               String?
  communication_recipients CommunicationRecipient[]
}

model CommunicationRecipient {
  id               String          @id @default(uuid())
  communication_id String
  communication    Communication   @relation(fields: [communication_id], references: [id])
  target_type      EventTargetType
  target_id        String?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  created_by       String
  updated_by       String
  is_deleted       Boolean         @default(false)
  deleted_at       DateTime?
  deleted_by       String?
}

model DirectMessage {
  id                        String                   @id @default(uuid())
  institution_id            String
  institution               Institution              @relation(fields: [institution_id], references: [id])
  sender_id                 String
  sender                    User                     @relation("SenderMessages", fields: [sender_id], references: [id])
  title                     String
  content                   String
  status                    String
  sent_at                   DateTime
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt
  created_by                String
  updated_by                String
  is_deleted                Boolean                  @default(false)
  deleted_at                DateTime?
  deleted_by                String?
  direct_message_recipients DirectMessageRecipient[]
}

model DirectMessageRecipient {
  id                String        @id @default(uuid())
  direct_message_id String
  direct_message    DirectMessage @relation(fields: [direct_message_id], references: [id])
  recipient_user_id String
  recipient_user    User          @relation("RecipientMessages", fields: [recipient_user_id], references: [id])
  recipient_role_id String
  recipient_role    Role          @relation(fields: [recipient_role_id], references: [id])
  read_at           DateTime
  sent_at           DateTime
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  created_by        String
  updated_by        String
  is_deleted        Boolean       @default(false)
  deleted_at        DateTime?
  deleted_by        String?
}

model Notification {
  id             String      @id @default(uuid())
  institution_id String
  institution    Institution @relation(fields: [institution_id], references: [id])
  user_id        String
  user           User        @relation(fields: [user_id], references: [id])
  type           String
  message        String
  read_status    Boolean
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  created_by     String
  updated_by     String
  is_deleted     Boolean     @default(false)
  deleted_at     DateTime?
  deleted_by     String?
}

model Setting {
  id             String      @id @default(uuid())
  institution_id String
  institution    Institution @relation(fields: [institution_id], references: [id])
  key            String
  value          String
  description    String
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  created_by     String
  updated_by     String
  is_deleted     Boolean     @default(false)
  deleted_at     DateTime?
  deleted_by     String?
}

model FundingPolicies {
  id          String   @id @default(uuid())
  entity_type EntityType
  entity_id   String
  max_percent Decimal
  annual_cap  Decimal
  year        Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  created_by  String
}

model ActivityFunding {
  id                          String                @id @default(uuid())
  activity_id                 String                @unique 
  activity                    ProjectActivity       @relation(fields: [activity_id], references: [id])
  entity_contribution_amount  Decimal
  entity_contribution_percent Float
  entity_type                 EntityType
  entity_id                   String
  validated                   Boolean               @default(false)
  created_at                  DateTime              @default(now())
  updated_at                  DateTime              @updatedAt
  created_by                  String?
  updated_by                  String?
  is_deleted                  Boolean               @default(false)
  deleted_at                  DateTime?
  deleted_by                  String?
}

model ActivityDocuments {
  id                  String           @id @default(uuid())
  activity_id         String
  file_url            String
  drive_file_id       String?
  filename            String           // Nome original do arquivo
  type                String
  is_validated        Boolean          @default(false)
  uploaded_by         String
  created_at          DateTime         @default(now())
  validated_at        DateTime?
  project_activity_id  String?
  project_activity     ProjectActivity? @relation(fields: [project_activity_id], references: [id])
  updated_at          DateTime         @updatedAt
  updated_by          String?
  is_deleted          Boolean          @default(false)
  deleted_at          DateTime?
  deleted_by          String?
}

model SpecialProjects {
  id                    String    @id @default(uuid())
  department_id         String
  institution_id        String?
  project_id            String?
  justification_note    String?
  budget                Decimal?
  subsidy_status_id   String
  type                  String
  location_church_plant String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  created_by            String
  updated_by            String
  is_deleted            Boolean   @default(false)
  deleted_at            DateTime?
  deleted_by            String?

  // Opposite relations
  project        Project?       @relation(fields: [project_id], references: [id])
  subsidy_status SubsidyStatus? @relation(fields: [subsidy_status_id], references: [id])
}


model UsedInviteTokens {
  id              String      @id @default(cuid())
  token           String      @unique
  usedAt          DateTime    @default(now())
  tokenExpiresAt  DateTime
}

model VerificationCode {
  id           String   @id @default(cuid())
  email        String
  code         String
  expiresAt    DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  used         Boolean  @default(false)
}
