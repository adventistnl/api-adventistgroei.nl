// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator nestgraphql {
  provider = "prisma-nestjs-graphql"
  output   = "../src/@generated" // Diretório onde os tipos serão gerados
}

// Enums
enum LanguagePreference {
  en
  nl
}

enum EventTargetType {
  institution
  region
  department
  church
  user
}

enum EventType {
  show
  evangelism
}

enum EventRegistrationStatus {
  paid
  pendent
  reserved
  approved
  canceled
}

enum PermissionResolverName {
  users
  user
  createUser
  updateUser
  deleteUser
  addRoleToUser
  removeRoleFromUser
  createInstitution
  institutions
  institution
  updateInstitution
  deleteInstitution
  regions
  region
  createRegion
  updateRegion
  deleteRegion
  churches
  church
  createChurch
  updateChurch
  deleteChurch
  permissions
  createRole
  updateRole
  deleteRole
  roles
  role
  auth
  departments
  department
  createDepartment
  updateDepartment
  deleteDepartment
  communications
  communication
  createCommunication
  updateCommunication
  deleteCommunication
  directMessages
  directMessage
  createDirectMessage
  updateDirectMessage
  deleteDirectMessage
  projects
  project
  createProject
  updateProject
  deleteProject
  notifications
  notification
  createNotification
  updateNotification
  deleteNotification
  settings
  setting
  createSetting
  updateSetting
  deleteSetting
  subsidyRequests
  subsidyRequest
  createSubsidyRequest
  updateSubsidyRequest
  deleteSubsidyRequest
  subsidyStatuses
  subsidyStatus
  createSubsidyStatus
  updateSubsidyStatus
  deleteSubsidyStatus
  addProjectVoluntary
  removeProjectVoluntary
  projectActivities
  projectActivity
  createProjectActivity
  updateProjectActivity
  deleteProjectActivity
  sendInviteEmail
  inviteUser
  validateInviteToken
}

enum PermissionGroup {
  USER
  INSTITUTION
  CHURCH
  REGION
  CONTACT
  ROLE
  PERMISSION
  DEPARTMENT
  COMMUNICATION
  DIRECT_MESSAGE
  PROJECT
  ACTIVITY
  NOTIFICATION
  SETTING
  SUBSIDY_REQUEST
  SUBSIDY_STATUS
  EMAIL_SEND
  INVITE
}

enum CommunicationType {
  EMAIL
  SMS
  PUSH_NOTIFICATION
  IN_APP_MESSAGE
}

enum CommunicationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CommunicationStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
}

enum ProjectType {
  MISSION
  EVANGELISM
  SOCIAL
  OTHER
}

// Enum para status do orçamento anual
enum AnnualBudgetStatus {
  PLANNED
  APPROVED
  IN_PROGRESS
  CLOSED
}

// Models
model Institution {
  id                  String             @id @default(uuid())
  name                String
  denomination        String
  description         String?
  language_preference LanguagePreference
  contact_id          String?            @unique
  contact             Contact?           @relation(fields: [contact_id], references: [id])
  annual_budget_id    String?
  annual_budget       AnnualBudget?      @relation(fields: [annual_budget_id], references: [id])
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  created_by          String
  updated_by          String
  is_deleted          Boolean            @default(false)
  deleted_at          DateTime?
  deleted_by          String?
  regions             Region[]
  churches            Church[]
  departments         Department[]
  users               User[]
  communications      Communication[]
  notifications       Notification[]
  settings            Setting[]
  projects            Project[]
  direct_messages     DirectMessage[]
  subsidy_requests    SubsidyRequest[]
}

model Region {
  id               String        @id @default(uuid())
  institution_id   String
  institution      Institution   @relation(fields: [institution_id], references: [id])
  name             String
  parent_region_id String?
  parent_region    Region?       @relation("ParentRegion", fields: [parent_region_id], references: [id])
  children         Region[]      @relation("ParentRegion")
  contact_id       String?
  contact          Contact?      @relation(fields: [contact_id], references: [id])
  annual_budget_id String?
  annual_budget    AnnualBudget? @relation(fields: [annual_budget_id], references: [id])
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  created_by       String
  updated_by       String
  is_deleted       Boolean       @default(false)
  deleted_at       DateTime?
  deleted_by       String?
  churches         Church[]
}

model Church {
  id               String           @id @default(uuid())
  institution_id   String
  institution      Institution      @relation(fields: [institution_id], references: [id])
  name             String
  region_id        String
  region           Region           @relation(fields: [region_id], references: [id])
  contact_id       String?
  contact          Contact?         @relation(fields: [contact_id], references: [id])
  annual_budget_id String?
  annual_budget    AnnualBudget?    @relation(fields: [annual_budget_id], references: [id])
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  created_by       String
  updated_by       String
  is_deleted       Boolean          @default(false)
  deleted_at       DateTime?
  deleted_by       String?
  departments      Department[]
  users            User[]
  subsidy_requests SubsidyRequest[]
}

model Department {
  id                String           @id @default(uuid())
  institution_id    String
  institution       Institution      @relation(fields: [institution_id], references: [id])
  church_id         String
  church            Church           @relation(fields: [church_id], references: [id])
  name              String
  description       String
  annual_budget_id  String?
  annual_budget     AnnualBudget?    @relation(fields: [annual_budget_id], references: [id])
  contact_id        String?
  contact           Contact?         @relation(fields: [contact_id], references: [id])
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  created_by        String
  updated_by        String
  is_deleted        Boolean          @default(false)
  deleted_at        DateTime?
  deleted_by        String?
  subsidy_statuses  SubsidyStatus[]
  projects          Project[]
  annual_reports    AnnualReport[]
  subsidy_requests  SubsidyRequest[]
  users             User[]
}

// Modelo AnnualBudget
model AnnualBudget {
  id             String             @id @default(uuid())
  year           Int
  planned_budget Decimal
  total_expenses Decimal
  balance        Decimal
  notes          String?
  approved_by    String?
  approved_user  User?              @relation("ApprovedAnnualBudgets", fields: [approved_by], references: [id])
  status         AnnualBudgetStatus @default(PLANNED)
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt
  created_by     String
  updated_by     String
  is_deleted     Boolean            @default(false)
  deleted_at     DateTime?
  deleted_by     String?
  institutions   Institution[]
  regions        Region[]
  churches       Church[]
  departments    Department[]
}

model Contact {
  id           String       @id @default(uuid())
  name         String?
  phone        String?
  mobile       String?
  email        String?
  country      String?
  city         String?
  address      String?
  full_address String?
  postal_code  String?
  website      String?
  notes        String?
  is_primary   Boolean
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  created_by   String
  updated_by   String
  is_deleted   Boolean      @default(false)
  deleted_at   DateTime?
  deleted_by   String?
  Institution  Institution?
  Region       Region[]
  Church       Church[]
  Department   Department[]
  User         User[]
  Event        Event[]
}

model User {
  id                        String                   @id @default(uuid())
  name                      String
  email                     String                   @unique
  password                  String
  language_preference       LanguagePreference
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt
  created_by                String
  updated_by                String
  is_deleted                Boolean                  @default(false)
  deleted_at                DateTime?
  deleted_by                String?
  contact_id                String?
  contact                   Contact?                 @relation(fields: [contact_id], references: [id])
  institution_id            String
  institution               Institution              @relation(fields: [institution_id], references: [id])
  church_id                 String
  church                    Church                   @relation(fields: [church_id], references: [id])
  department_id             String
  department                Department               @relation(fields: [department_id], references: [id])
  user_roles                UserRole[]
  direct_messages           DirectMessage[]          @relation("SenderMessages")
  direct_message_recipients DirectMessageRecipient[] @relation("RecipientMessages")
  notifications             Notification[]
  event_registrations       EventRegistration[]
  event_recipients          EventRecipient[]
  communications            Communication[]          @relation("AuthorCommunications")
  SubsidyRequest            SubsidyRequest[]
  SubsidyStatus             SubsidyStatus[]
  voluntary_projects        VoluntariesOnProjects[]
  Project                   Project[]
  approved_annual_budgets   AnnualBudget[]           @relation("ApprovedAnnualBudgets")
}

model Project {
  id                  String                  @id @default(uuid())
  department_id       String
  department          Department              @relation(fields: [department_id], references: [id])
  title               String
  description         String
  budget              Decimal
  media_link          String
  owner_id            String
  owner               User                    @relation(fields: [owner_id], references: [id])
  language_preference LanguagePreference
  type                ProjectType
  created_at          DateTime                @default(now())
  updated_at          DateTime                @updatedAt
  created_by          String
  updated_by          String
  is_deleted          Boolean                 @default(false)
  deleted_at          DateTime?
  deleted_by          String?
  event_id            String?
  event               Event?                  @relation(fields: [event_id], references: [id])
  Institution         Institution?            @relation(fields: [institution_id], references: [id])
  institution_id      String?
  voluntary_users     VoluntariesOnProjects[]
  activities          ProjectActivity[]
  subsidies           SubsidyRequest[]
}

model VoluntariesOnProjects {
  user       User    @relation(fields: [user_id], references: [id])
  user_id    String
  project    Project @relation(fields: [project_id], references: [id])
  project_id String

  @@id([user_id, project_id])
}

model Role {
  id                        String                   @id @default(uuid())
  name                      String
  description               String
  color                     String?                  @default("#3b82f6")
  key_code                  String                   @unique
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt
  created_by                String
  updated_by                String
  is_deleted                Boolean                  @default(false)
  deleted_at                DateTime?
  deleted_by                String?
  user_roles                UserRole[]
  role_permissions          RolePermission[]
  direct_message_recipients DirectMessageRecipient[]
}

model Permission {
  id               String                 @id @default(uuid())
  name             String
  description      String
  key_code         String                 @unique
  resolver_name    PermissionResolverName @unique
  group            PermissionGroup?
  created_at       DateTime               @default(now())
  updated_at       DateTime               @updatedAt
  created_by       String
  updated_by       String
  is_deleted       Boolean                @default(false)
  deleted_at       DateTime?
  deleted_by       String?
  role_permissions RolePermission[]
}

model RolePermission {
  id            String     @id @default(uuid())
  role_id       String
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [id])
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  created_by    String
  updated_by    String
  is_deleted    Boolean    @default(false)
  deleted_at    DateTime?
  deleted_by    String?
}

model UserRole {
  id         String    @id @default(uuid())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id])
  role_id    String
  role       Role      @relation(fields: [role_id], references: [id])
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  created_by String
  updated_by String
  is_deleted Boolean   @default(false)
  deleted_at DateTime?
  deleted_by String?
}

model SubsidyRequest {
  id                  String            @id @default(uuid())
  description         String
  total_budget        Decimal
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt
  created_by          String
  updated_by          String
  is_deleted          Boolean           @default(false)
  deleted_at          DateTime?
  deleted_by          String?
  institution_id      String
  institution         Institution       @relation(fields: [institution_id], references: [id])
  requester_id        String
  requester           User              @relation(fields: [requester_id], references: [id])
  department_id       String
  department          Department        @relation(fields: [department_id], references: [id])
  church_id           String
  church              Church            @relation(fields: [church_id], references: [id])
  subsidy_statuses_id String
  subsidy_status      SubsidyStatus     @relation(fields: [subsidy_statuses_id], references: [id])
  project_activities  ProjectActivity[]
  project_id          String
  project             Project           @relation(fields: [project_id], references: [id])
}

model ProjectActivity {
  id               String           @id @default(uuid())
  subsidy_request  SubsidyRequest[]
  project_id       String
  project          Project          @relation(fields: [project_id], references: [id])
  name             String
  description      String
  budget_amount    Decimal
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  created_by       String
  updated_by       String
  is_deleted       Boolean          @default(false)
  deleted_at       DateTime?
  deleted_by       String?
  subsidy_receipts SubsidyReceipt[]
}

model SubsidyReceipt {
  id                    String          @id @default(uuid())
  project_activities_id String
  project_activity      ProjectActivity @relation(fields: [project_activities_id], references: [id])
  file_path             String
  amount                Decimal
  approved              Boolean
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt
  created_by            String
  updated_by            String
  is_deleted            Boolean         @default(false)
  deleted_at            DateTime?
  deleted_by            String?
}

model SubsidyStatus {
  id               String           @id @default(uuid())
  department_id    String
  department       Department       @relation(fields: [department_id], references: [id])
  assigned_to      String
  assigned_user    User             @relation(fields: [assigned_to], references: [id])
  name             String
  description      String
  order            Int
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  created_by       String
  updated_by       String
  is_deleted       Boolean          @default(false)
  deleted_at       DateTime?
  deleted_by       String?
  subsidy_requests SubsidyRequest[]
}

model AnnualReport {
  id              String     @id @default(uuid())
  department_id   String
  department      Department @relation(fields: [department_id], references: [id])
  text            String
  file_path       String
  submission_date DateTime
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  created_by      String
  updated_by      String
  is_deleted      Boolean    @default(false)
  deleted_at      DateTime?
  deleted_by      String?
}

model Event {
  id                      String              @id @default(uuid())
  target_type             EventTargetType
  target_id               String?
  title                   String
  description             String
  contact_id              String
  contact                 Contact             @relation(fields: [contact_id], references: [id])
  type                    EventType
  language_preference     LanguagePreference
  max_participants        Int
  ticket_amount           Decimal
  location                String?
  is_private              Boolean             @default(false)
  required_volunteers     Boolean             @default(false)
  start_at                DateTime?
  end_at                  DateTime?
  subscription_expires_at DateTime
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt
  created_by              String
  updated_by              String
  is_deleted              Boolean             @default(false)
  deleted_at              DateTime?
  deleted_by              String?
  event_recipients        EventRecipient[]
  event_registrations     EventRegistration[]
  projects                Project[]
}

model EventRecipient {
  id          String          @id @default(uuid())
  event_id    String
  event       Event           @relation(fields: [event_id], references: [id])
  target_type EventTargetType
  target_id   String
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  created_by  String
  updated_by  String
  is_deleted  Boolean         @default(false)
  deleted_at  DateTime?
  deleted_by  String?
  User        User?           @relation(fields: [userId], references: [id])
  userId      String?
}

model EventRegistration {
  id         String                  @id @default(uuid())
  user_id    String
  user       User                    @relation(fields: [user_id], references: [id])
  event_id   String
  event      Event                   @relation(fields: [event_id], references: [id])
  status     EventRegistrationStatus
  created_at DateTime                @default(now())
  updated_at DateTime                @updatedAt
  created_by String
  updated_by String
  is_deleted Boolean                 @default(false)
  deleted_at DateTime?
  deleted_by String?
}

model Communication {
  id                       String                   @id @default(uuid())
  institution_id           String
  institution              Institution              @relation(fields: [institution_id], references: [id])
  title                    String
  content                  String
  type                     String
  priority                 String
  status                   String
  language_preference      LanguagePreference
  schedule_at              DateTime
  published_at             DateTime
  author_id                String
  author                   User                     @relation("AuthorCommunications", fields: [author_id], references: [id])
  created_at               DateTime                 @default(now())
  updated_at               DateTime                 @updatedAt
  created_by               String
  updated_by               String
  is_deleted               Boolean                  @default(false)
  deleted_at               DateTime?
  deleted_by               String?
  communication_recipients CommunicationRecipient[]
}

model CommunicationRecipient {
  id               String          @id @default(uuid())
  communication_id String
  communication    Communication   @relation(fields: [communication_id], references: [id])
  target_type      EventTargetType
  target_id        String?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  created_by       String
  updated_by       String
  is_deleted       Boolean         @default(false)
  deleted_at       DateTime?
  deleted_by       String?
}

model DirectMessage {
  id                        String                   @id @default(uuid())
  institution_id            String
  institution               Institution              @relation(fields: [institution_id], references: [id])
  sender_id                 String
  sender                    User                     @relation("SenderMessages", fields: [sender_id], references: [id])
  title                     String
  content                   String
  status                    String
  sent_at                   DateTime
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt
  created_by                String
  updated_by                String
  is_deleted                Boolean                  @default(false)
  deleted_at                DateTime?
  deleted_by                String?
  direct_message_recipients DirectMessageRecipient[]
}

model DirectMessageRecipient {
  id                String        @id @default(uuid())
  direct_message_id String
  direct_message    DirectMessage @relation(fields: [direct_message_id], references: [id])
  recipient_user_id String
  recipient_user    User          @relation("RecipientMessages", fields: [recipient_user_id], references: [id])
  recipient_role_id String
  recipient_role    Role          @relation(fields: [recipient_role_id], references: [id])
  read_at           DateTime
  sent_at           DateTime
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  created_by        String
  updated_by        String
  is_deleted        Boolean       @default(false)
  deleted_at        DateTime?
  deleted_by        String?
}

model Notification {
  id             String      @id @default(uuid())
  institution_id String
  institution    Institution @relation(fields: [institution_id], references: [id])
  user_id        String
  user           User        @relation(fields: [user_id], references: [id])
  type           String
  message        String
  read_status    Boolean
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  created_by     String
  updated_by     String
  is_deleted     Boolean     @default(false)
  deleted_at     DateTime?
  deleted_by     String?
}

model Setting {
  id             String      @id @default(uuid())
  institution_id String
  institution    Institution @relation(fields: [institution_id], references: [id])
  key            String
  value          String
  description    String
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  created_by     String
  updated_by     String
  is_deleted     Boolean     @default(false)
  deleted_at     DateTime?
  deleted_by     String?
}
