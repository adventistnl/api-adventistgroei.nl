  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset --force",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "seed:permissions": "ts-node -r tsconfig-paths/register src/scripts/seed-permissions.ts",
    "seed:roles": "ts-node -r tsconfig-paths/register src/scripts/seed-roles.ts",
    "seed:users": "ts-node -r tsconfig-paths/register src/scripts/seed-users.ts",
    "seed:subsidy-statuses": "ts-node -r tsconfig-paths/register src/scripts/seed-subsidy-statuses.ts",
    "seed:department-transactions": "ts-node -r tsconfig-paths/register src/scripts/seed-department-transactions.ts",
    "seed:dev": "ts-node -r tsconfig-paths/register src/scripts/seed-developer-role.ts",
    "seed:prod:admin": "ts-node -r tsconfig-paths/register src/scripts/seed-admin-prod.ts",
    "seed:prod:developer": "ts-node -r tsconfig-paths/register src/scripts/seed-developer-prod.ts",
    "seed:prod:full": "ts-node -r tsconfig-paths/register src/scripts/seed-prod-full.ts",
    "seed:institution-positions": "ts-node -r tsconfig-paths/register src/scripts/seed-institution-positions.ts",
    "seed:prod:all": "pnpm run seed:permissions && pnpm run seed:roles && pnpm run seed:prod:full && pnpm run seed:institution-positions",
    "seed:all": "pnpm run seed:permissions && pnpm run seed:roles && pnpm run seed:users && pnpm run seed:subsidy-statuses && pnpm run seed:institution-positions",
    "cleanup:orphaned-subsidies": "ts-node -r tsconfig-paths/register src/scripts/cleanup-orphaned-subsidy-requests.ts",
    "prisma:reset:dev": "pnpm run prisma:migrate:reset && pnpm run prisma:generate && pnpm run seed:all && pnpm run start:dev"
  },
