  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--max-old-space-size=8192 jest --config ./test/jest-e2e.json --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:format": "prisma format",
    "ts-run": "ts-node -r tsconfig-paths/register",
    "seed:perms": "pnpm ts-run src/scripts/seed-permissions.ts",
    "seed:roles": "pnpm ts-run src/scripts/seed-roles.ts",
    "seed:structure": "pnpm ts-run src/scripts/seed-structure.ts",
    "seed:users": "pnpm ts-run src/scripts/seed-users.ts",
    "seed:statuses": "pnpm ts-run src/scripts/seed-statuses.ts",
    "seed:positions": "pnpm ts-run src/scripts/seed-positions.ts",
    "seed:txns": "pnpm ts-run src/scripts/seed-department-transactions.ts",
    "seed:admin": "pnpm ts-run src/scripts/seed-admin.ts",
    "seed:all:dev": "pnpm seed:perms && pnpm seed:roles && pnpm seed:structure && pnpm seed:users && pnpm seed:statuses && pnpm seed:positions",
    "seed:all:prod": "pnpm seed:perms && pnpm seed:roles && pnpm seed:statuses && pnpm seed:admin",
    "cleanup:orphans": "pnpm ts-run src/scripts/cleanup-orphaned-subsidy-requests.ts",
    "dev:reset": "pnpm db:migrate:reset && pnpm db:generate && pnpm seed:all:dev && pnpm start:dev"
  },
